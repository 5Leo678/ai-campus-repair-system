.login-page {
  position: relative;
  overflow: hidden;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.login-card {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  padding: 58rpx 40rpx 42rpx;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 28rpx 76rpx rgba(52, 103, 65, 0.12);
}

.brand-mark {
  position: relative;
  display: flex;
  width: 126rpx;
  height: 126rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d5ebd8;
  border-radius: 38rpx;
  background: #eef1ef;
  color: #25845f;
  font-size: 64rpx;
  font-weight: 700;
  box-shadow: none;
}

.eyebrow {
  margin-top: 32rpx;
  color: #69a17a;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 36rpx;
  color: #254637;
  font-size: 44rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 20rpx;
  color: #819689;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.7;
}

.login-benefit {
  display: flex;
  width: 100%;
  margin-top: 46rpx;
  padding: 20rpx 18rpx;
  align-items: center;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #f1f8f1;
  color: #668271;
  font-size: 22rpx;
}

.benefit-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #51a573;
  box-shadow: 0 0 0 6rpx rgba(81, 165, 115, 0.12);
}

.login-button {
  width: 100%;
  margin-top: 36rpx;
}

.privacy-note {
  margin-top: 26rpx;
  color: #9baa9e;
  font-size: 22rpx;
}

.login-page {
  background: #f7f8fa;
}

.login-orbit,
.brand-leaf {
  display: none;
}

.login-card {
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(35, 46, 40, 0.06);
}

.brand-mark {
  border: 0;
  border-radius: 18rpx;
  background: #eef1ef;
  color: #6f8377;
  box-shadow: none;
}

.eyebrow,
.subtitle,
.privacy-note {
  color: #999999;
}

.title {
  color: #222222;
}

.login-benefit {
  border-radius: 18rpx;
  background: #f1f3f4;
  color: #666666;
}

.benefit-dot {
  background: #718579;
  box-shadow: none;
}

.login-button,
.login-button[disabled] {
  border-radius: 18rpx;
  background: #6f8377;
  box-shadow: none;
}

.login-page {
  background: linear-gradient(145deg, #f0f7f4, #f6f7fb 58%, #fbf4f5);
}

.login-orbit {
  display: block;
  border-color: rgba(125, 174, 153, 0.2);
}

.orbit-one {
  box-shadow: 0 0 0 30rpx rgba(255, 255, 255, 0.28), 0 0 0 68rpx rgba(139, 192, 170, 0.07);
}

.orbit-two {
  box-shadow: 0 0 0 28rpx rgba(255, 255, 255, 0.26);
}

.login-card {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(250, 253, 251, 0.94));
  box-shadow: 0 18rpx 42rpx rgba(72, 111, 94, 0.12), 0 5rpx 14rpx rgba(72, 111, 94, 0.06);
}

.brand-mark {
  border-radius: 30rpx;
  background: linear-gradient(145deg, #dff0e8, #e7f0f8);
  color: #6b9b86;
}

.brand-leaf {
  display: block;
  background: #9dcbb4;
}

.eyebrow {
  color: #7aa38f;
}

.title {
  color: #263b34;
  text-shadow: 0 3rpx 10rpx rgba(70, 105, 91, 0.08);
}

.login-benefit {
  border-radius: 18rpx;
  background: linear-gradient(110deg, #edf6f1, #eff4f9 70%, #fbf0f2);
}

.benefit-dot {
  background: #84b7a0;
  box-shadow: 0 0 0 5rpx rgba(132, 183, 160, 0.14);
}

.login-button,
.login-button[disabled] {
  border-radius: 24rpx;
  background: linear-gradient(115deg, #6ea897, #83b9a7);
  box-shadow: 0 12rpx 24rpx rgba(90, 151, 129, 0.2);
}

.login-card {
  overflow: hidden;
  padding-top: 48rpx;
}

.login-brand-banner {
  position: relative;
  display: flex;
  width: 100%;
  align-items: center;
  flex-direction: column;
  padding: 18rpx 18rpx 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #e1f0e9, #eaf2f6 68%, #f8edef);
}

.login-banner-dots {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 76rpx;
  height: 34rpx;
}

.login-banner-dots .dot-one {
  top: 2rpx;
  right: 4rpx;
}

.login-banner-dots .dot-two {
  right: 30rpx;
  bottom: 4rpx;
}

.login-heading {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  font-size: 56rpx;
}

.eyebrow {
  margin-top: 24rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 42rpx;
}

.subtitle {
  margin-top: 14rpx;
}

.login-benefit {
  margin-top: 32rpx;
}

.benefit-icon {
  margin-right: 12rpx;
  color: #6e9985;
}

.login-button,
.login-button[disabled] {
  margin-top: 28rpx;
}
