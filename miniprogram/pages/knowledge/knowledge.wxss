.page-heading {
  display: flex;
  min-height: 150rpx;
  flex-direction: column;
  justify-content: center;
  margin: 0 0 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #d7e9da;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(48, 91, 56, 0.045);
}

.heading-title {
  color: #203f31;
  font-size: 38rpx;
  font-weight: 700;
}

.heading-subtitle {
  margin-top: 10rpx;
  color: #718a78;
  font-size: 23rpx;
  line-height: 1.5;
}

.safety-notice {
  padding: 28rpx;
  border: 1rpx solid #f0d7b4;
  border-radius: 22rpx;
  background: #f1f2ef;
  box-shadow: 0 10rpx 24rpx rgba(139, 94, 31, 0.055);
}

.notice-title {
  display: block;
  color: #9a6018;
  font-size: 27rpx;
  font-weight: 700;
}

.notice-copy {
  display: block;
  margin-top: 12rpx;
  color: #866c4e;
  font-size: 23rpx;
  line-height: 1.7;
}

.guide-card {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #e5eee4;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(37, 73, 48, 0.055);
}

.guide-title {
  display: block;
  color: #355542;
  font-size: 28rpx;
  font-weight: 700;
}

.guide-line {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.guide-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin: 12rpx 14rpx 0 0;
  border-radius: 50%;
  background: #65a978;
}

.guide-copy {
  flex: 1;
  color: #687f70;
  font-size: 24rpx;
  line-height: 1.7;
}

.page-heading {
  min-height: 0;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(35, 46, 40, 0.04);
}

.heading-title,
.guide-title {
  color: #222222;
}

.heading-subtitle,
.guide-copy {
  color: #444444;
}

.safety-notice,
.guide-card {
  border: 0;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(35, 46, 40, 0.04);
}

.safety-notice {
  background: #f1f2ef;
}

.notice-title {
  color: #444444;
}

.notice-copy {
  color: #666666;
}

.guide-dot {
  background: #718579;
}

.page-heading {
  min-height: 150rpx;
}

.safety-notice {
  border: 1rpx solid rgba(237, 215, 187, 0.7);
  background: linear-gradient(130deg, #fff5e9, #fff9f3 72%, #fff1f2);
}

.guide-card {
  background: linear-gradient(145deg, #ffffff, #ffffff 76%, #f5faf8);
}

.guide-dot {
  background: linear-gradient(145deg, #78b49b, #9dc9b7);
  box-shadow: 0 3rpx 8rpx rgba(95, 155, 132, 0.2);
}

.page-heading {
  display: flex;
  align-items: center;
  min-height: 150rpx;
  margin: 0 0 24rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #e1f0e9, #eaf2f6 68%, #f8edef);
  box-shadow: 0 8rpx 22rpx rgba(76, 118, 99, 0.08);
}

.heading-mark {
  margin-right: 18rpx;
}

.heading-title {
  color: #222222;
  font-size: 38rpx;
}

.heading-subtitle {
  color: #999999;
  font-size: 22rpx;
}

.safety-notice,
.guide-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #e4ece7;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 20rpx rgba(56, 83, 68, 0.055);
}

.safety-notice {
  background: #f6f2ec;
}

.section-heading {
  margin-bottom: 14rpx;
}

.notice-title {
  color: #444444;
}

.notice-copy,
.guide-copy {
  color: #555f59;
}
