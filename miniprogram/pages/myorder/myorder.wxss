  padding-top: 20rpx;
}

.card-footer::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(124, 170, 150, 0.45), rgba(191, 170, 183, 0.18), transparent);
  content: '';
}

.search-bar,
.status-filter,
.search-button,
.clear-search-button,
.refresh-button {
