<view class="page-container profile-page">
  <view class="profile-hero">
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">{{avatarText}}</view>
      <view class="avatar-edit" wx:if="{{!uploadingAvatar}}">更换</view>
      <view class="avatar-uploading" wx:else>上传中</view>
    </view>
    <view class="hero-copy">
      <text class="profile-page-title">个人资料</text>
      <text class="hero-name">{{nickname || '微信用户'}}</text>
      <text class="hero-caption">校园报修用户 · 加入于 {{memberSince}}</text>
    </view>
    <button class="hero-refresh" loading="{{refreshing}}" bindtap="loadPageData">刷新</button>
  </view>

  <view wx:if="{{loading}}" class="state-container">
    <view class="loading-dot"></view>
    <text class="state-text">正在加载资料...</text>
  </view>

  <block wx:else>
    <view class="stats-card">
      <view class="stats-heading">
        <view class="section-heading"><text class="section-icon">▤</text><text class="section-title">我的报修</text></view>
        <text class="section-link" bindtap="openMyOrders">全部工单 ›</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item" bindtap="openMyOrders">
          <text class="stat-number">{{orderStats.total}}</text>
          <text class="stat-label">全部工单</text>
        </view>
        <view class="stat-item" bindtap="openMyOrders">
          <text class="stat-number">{{orderStats.pending}}</text>
          <text class="stat-label">待处理</text>
        </view>
        <view class="stat-item" bindtap="openMyOrders">
          <text class="stat-number">{{orderStats.processing}}</text>
          <text class="stat-label">维修中</text>
        </view>
        <view class="stat-item" bindtap="openMyOrders">
          <text class="stat-number">{{orderStats.finished}}</text>
          <text class="stat-label">已完成</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <view class="section-heading-title"><text class="section-icon">◷</text><text class="section-title">最近工单</text></view>
        <text class="section-link" bindtap="openMyOrders">查看全部 ›</text>
      </view>
      <view wx:if="{{recentOrders.length}}" class="recent-order-list">
        <view
          wx:for="{{recentOrders}}"
          wx:key="id"
          class="recent-order"
          data-id="{{item.id}}"
          bindtap="openRecentOrder"
        >
          <view class="recent-order-main">
            <text class="recent-order-title">{{item.title}}</text>
            <text class="recent-order-location">{{item.location}}</text>
          </view>
          <view class="recent-order-side">
            <text class="recent-status">{{item.statusText}}</text>
            <text class="recent-date">{{item.dateText}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-orders">
        <text class="empty-orders-copy">还没有报修记录</text>
        <text class="section-link" bindtap="openSubmit">立即提交 ›</text>
      </view>
    </view>

    <view class="section-card profile-card">
      <view class="section-heading">
        <view class="section-heading-title"><text class="section-icon">♙</text><text class="section-title">个人资料</text></view>
        <text class="profile-id">用户 #{{wxUserId}}</text>
      </view>
      <view class="form-item">
        <text class="label">昵称</text>
        <input class="text-input" value="{{nickname}}" data-field="nickname" bindinput="handleInput" maxlength="64" placeholder="请输入昵称" />
      </view>
      <view class="form-item last-item">
        <text class="label">联系电话</text>
        <input class="text-input" type="text" value="{{phone}}" data-field="phone" bindinput="handleInput" maxlength="20" placeholder="用于维修人员联系，可留空" />
      </view>
      <button class="primary-button save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile"><text class="button-icon">✓</text>保存资料</button>
    </view>

    <view class="section-card shortcuts-card">
      <view class="section-heading"><text class="section-icon">⌘</text><text class="section-title">常用服务</text></view>
      <view class="shortcut-row" bindtap="openSubmit">
        <text class="shortcut-icon">＋</text>
        <text class="shortcut-label">提交新的报修</text>
        <text class="shortcut-arrow">›</text>
      </view>
      <view class="shortcut-row" bindtap="openNotifications">
        <text class="shortcut-icon">◉</text>
        <text class="shortcut-label">消息通知</text>
        <text wx:if="{{unreadCount}}" class="shortcut-badge">{{unreadCount > 99 ? '99+' : unreadCount}} 条未读</text>
        <text class="shortcut-arrow">›</text>
      </view>
    </view>

    <view class="privacy-card">
      <view class="section-heading"><text class="section-icon">◇</text><text class="privacy-title">信息使用与隐私保护</text></view>
      <text class="privacy-copy">昵称和联系电话用于识别报修记录及维修联系。联系电话仅向有权限处理该工单的管理人员展示。</text>
      <text class="privacy-copy">请勿在故障描述或补充说明中填写密码、验证码、身份证号等敏感信息。工单及沟通记录会按系统记录保留；如需更正或删除个人信息，请联系校园报修管理人员。</text>
    </view>

    <button class="logout-button" bindtap="logout">退出登录</button>
  </block>
</view>
